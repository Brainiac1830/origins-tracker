// ============================================================
// firestore.rules — who is allowed to read and change what.
//
// This file is a copy for your records. The rules that count are the ones
// on the Firebase website:  Firestore Database > Rules tab > paste > Publish
//
// 1. Put your own Gmail in OWNER (only you can read the old shared data,
//    which is moved into your own folder the first time you sign in).
// 2. Put every player's Gmail (yours too) in the PLAYERS list.
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Who's who ----
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email == "brainiaccryptostuff@gmail.com";
    }
    function isPlayer() {
      return signedIn() && request.auth.token.email in [
        "brainiaccryptostuff@gmail.com",
        "kyal@jacobi-sutton.com"
      ];
    }

    // ---- Each player's private folder: only that player can read or change it ----
    match /users/{userId}/{document=**} {
      allow read, write: if isPlayer() && request.auth.uid == userId;
    }

    // ---- Shared location counter: every player can read it and add to it ----
    match /stats/{docId} {
      allow read, write: if isPlayer();
    }

    // ---- Old shared data (from before the update): owner can read it, nobody can change it ----
    match /decks/{docId}   { allow read: if isOwner(); }
    match /matches/{docId} { allow read: if isOwner(); }
    match /meta/{docId}    { allow read: if isOwner(); }
  }
}
